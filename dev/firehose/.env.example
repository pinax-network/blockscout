# Copy to `.env` (gitignored) or export these directly. Real environment variables take
# precedence over anything set here.

# Firehose gRPC endpoint, host:port. TLS is assumed unless FIREHOSE_PLAINTEXT=true.
FIREHOSE_ENDPOINT=<chain>.firehose.<provider>:443

# --- authentication: set ONE of the following, whichever your provider issues ---

# Long-lived API key, sent as the `x-api-key` metadata header.
# Used by Pinax and StreamingFast hosted endpoints.
FIREHOSE_API_KEY=

# Short-lived JWT, sent as `authorization: bearer <token>`.
# Used by deployments fronted by StreamingFast's auth service.
# FIREHOSE_BEARER_TOKEN=

# --- optional ---

# HTTP port this connector listens on; must match Blockscout's INDEXER_FIREHOSE_URL.
PORT=8082

# Worker processes. Protobuf decode + JSON encode is CPU-bound and pins one core, so a single
# worker caps the whole pipeline at ~16 blocks/s no matter how many ranges Blockscout requests
# concurrently. Defaults to (cores - 2).
FIREHOSE_WORKERS=8

# Set to true for a non-TLS endpoint, e.g. a local firehose-ethereum instance.
# FIREHOSE_PLAINTEXT=false
